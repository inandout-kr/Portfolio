{
  "name": "patina",
  "version": "0.1.0",
  "private": true,
  "description": "Patina(파티나) — 오래 써야 생기는 광택처럼, 시간으로만 쌓이는 익명 평판 프로토콜 (MVP 코어)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "npm run build && node --test --test-reporter=spec \"dist/test/**/*.test.js\"",
    "demo": "npm run build && node dist/demo/simulate.js",
    "mutate": "node scripts/mutate.mjs",
    "app:build": "node scripts/build-app.mjs",
    "app": "npm run build && npm run app:build && node dist/app/server.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "buffer": "6.0.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "qrcode-generator": "2.0.4"
  }
}
