{
  "name": "mukeunji",
  "version": "0.1.0",
  "private": true,
  "description": "묵은지 — 시간이 지나야 맛이 드는 익명 평판 프로토콜 (MVP 코어)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p .",
